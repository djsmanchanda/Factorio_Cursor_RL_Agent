{
  "version": "1.0.0",
  "purpose": "Clean Laya runner mission catalog: the hard plan-legality rule plus the user's mod_playground strategy (docs/rl/Laya_Strategy_Guidelines.md). Scopes are mission.* so other runners never select these rules. 'prefer' entries weight the guided policy: when a decision feature matches, multiply the option weight.",
  "rules": [
    {
      "rule_id": "rule.plan-legality",
      "kind": "hard",
      "scopes": [
        "*"
      ],
      "source": "docs/system_invariants.md",
      "quote": "Candidate plans must pass shared hard validators for Factorio legality, collisions, available resources, fluid purity, and scope."
    },
    {
      "rule_id": "mission.grid-parcels",
      "kind": "soft",
      "scopes": [
        "mission.plan"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "When land_model=grid, keep each build within one 64-tile parcel and reserve lattice corridors for belts, pipes and poles.",
      "prefer": []
    },
    {
      "rule_id": "mission.grid-growth",
      "kind": "soft",
      "scopes": [
        "mission.plan"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "When land_model=grid, prefer growth into adjacent parcels near the purpose's inputs.",
      "prefer": []
    },
    {
      "rule_id": "mission.item-blocks",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Reserve expansion space beside each item's inputs and grow from the nearest free edge.",
      "prefer": [
        {
          "when": {
            "family": "line",
            "next_slot": false
          },
          "weight": 0.2
        }
      ]
    },
    {
      "rule_id": "mission.goal",
      "kind": "soft",
      "scopes": [
        "mission.build",
        "mission.research"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Start from the mod_playground starter kit and reach advanced circuits, then self-expand and meet all item needs."
    },
    {
      "rule_id": "mission.science",
      "kind": "soft",
      "scopes": [
        "mission.research"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "After advanced circuits, manufacture and deliver the required science packs to labs and complete mining-productivity-4 research."
    },
    {
      "rule_id": "mission.no-gifts",
      "kind": "soft",
      "scopes": [
        "mission.goal",
        "mission.build"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Use only the starter kit and items the factory manufactures; never borrow player inventory or gifted items."
    },
    {
      "rule_id": "mission.starter-mines",
      "kind": "soft",
      "scopes": [
        "mission.opening",
        "mission.mine"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer iron and copper starters first, then stone and mall capacity.",
      "prefer": [
        {
          "when": {
            "need": "item:iron-*"
          },
          "weight": 1.5
        },
        {
          "when": {
            "need": "item:copper-*"
          },
          "weight": 1.5
        }
      ]
    },
    {
      "rule_id": "mission.starter-mall",
      "kind": "soft",
      "scopes": [
        "mission.opening",
        "mission.mall"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Bootstrap with four assemblers: protected gear and cable anchors plus two rotating cells."
    },
    {
      "rule_id": "mission.plate-lines",
      "kind": "soft",
      "scopes": [
        "mission.opening",
        "mission.mine",
        "mission.smelt"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Use approved six-drill mine and smelting modules for later plate capacity; expand against measured demand."
    },
    {
      "rule_id": "mission.furnace-reference",
      "kind": "soft",
      "scopes": [
        "mission.smelt"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Treat 12 iron, 12 copper and 6 stone furnaces as a reference allocation; measure whether ore supply and demand justify it."
    },
    {
      "rule_id": "mission.bot-supply",
      "kind": "soft",
      "scopes": [
        "mission.transport",
        "mission.mall",
        "mission.assemble"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Use logistic bots to supply one or two machines and mall machines."
    },
    {
      "rule_id": "mission.belt-transfer",
      "kind": "soft",
      "scopes": [
        "mission.transport",
        "mission.assemble",
        "mission.smelt"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Once demand and sustained production exceed what one or two bot-fed machines need, switch to direct belt transfers."
    },
    {
      "rule_id": "mission.quad-long-arms",
      "kind": "soft",
      "scopes": [
        "mission.mall"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Build vertical quad slots only when their long-handed inserters are funded; regular inserters cannot substitute."
    },
    {
      "rule_id": "mission.substation-areas",
      "kind": "soft",
      "scopes": [
        "mission.power",
        "mission.mine",
        "mission.mall"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Use substations only in mine and mall areas, where one substation powers many machines and there is space for it.",
      "prefer": [
        {
          "when": {
            "power": "e"
          },
          "weight": 2.0
        },
        {
          "when": {
            "power": "s"
          },
          "weight": 0.6
        }
      ]
    },
    {
      "rule_id": "mission.medium-poles",
      "kind": "soft",
      "scopes": [
        "mission.power"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer medium poles outside mine and mall areas; price their full bill from live recipes.",
      "prefer": [
        {
          "when": {
            "power": "m"
          },
          "weight": 1.3
        }
      ]
    },
    {
      "rule_id": "mission.big-pole-relay",
      "kind": "soft",
      "scopes": [
        "mission.power"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer big poles for long-distance connections; compare the full route bill with alternatives.",
      "prefer": [
        {
          "when": {
            "power": "b"
          },
          "weight": 1.5
        }
      ]
    },
    {
      "rule_id": "mission.land-plan",
      "kind": "soft",
      "scopes": [
        "mission.plan"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Protect usable ore for mining, reserve nearby smelting and transport space, and keep the mall together."
    },
    {
      "rule_id": "mission.phase-goals-first",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer actions that close current goal gaps or unblock them; preserve useful parallel progress.",
      "prefer": [
        {
          "when": {
            "goal_need": true
          },
          "weight": 3.0
        },
        {
          "when": {
            "goal_need": false,
            "goal_options_available": true
          },
          "weight": 0.2
        }
      ]
    },
    {
      "rule_id": "mission.serve-bottleneck",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer the deepest unmet input in the measured bottleneck chain.",
      "prefer": [
        {
          "when": {
            "in_bottleneck": true
          },
          "weight": 2.0
        },
        {
          "when": {
            "deepest_bottleneck": true
          },
          "weight": 2.0
        },
        {
          "when": {
            "family": [
              "mine",
              "smelt",
              "assemble"
            ],
            "deepest_bottleneck": true
          },
          "weight": 2.0
        }
      ]
    },
    {
      "rule_id": "mission.make-construction-items",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Make construction items that outstanding useful builds are short of.",
      "prefer": [
        {
          "when": {
            "need": "stock:*"
          },
          "weight": 2.5
        },
        {
          "when": {
            "stock_target": true
          },
          "weight": 2.5
        }
      ]
    },
    {
      "rule_id": "mission.protect-goal-stock",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Defer a side build that would make every current goal build unaffordable.",
      "prefer": [
        {
          "when": {
            "starves_goal": true
          },
          "weight": 0.05
        }
      ]
    },
    {
      "rule_id": "mission.inputs-first",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer builds with stocked inputs or working input supply; establish missing inputs first.",
      "prefer": []
    },
    {
      "rule_id": "mission.rotating-mall",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "During bootstrap, keep gear and cable anchors; retarget an idle or stocked rotating cell before adding capacity.",
      "prefer": [
        {
          "when": {
            "family": "retarget",
            "slot_free": true
          },
          "weight": 3.0
        },
        {
          "when": {
            "family": "retarget",
            "slot_permanent": true
          },
          "weight": 0.1
        },
        {
          "when": {
            "family": "retarget",
            "slot_from_goal": true
          },
          "weight": 0.1
        }
      ]
    },
    {
      "rule_id": "mission.stock-gates",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Gate mall stock at useful targets; products being measured for the current phase run ungated.",
      "prefer": []
    },
    {
      "rule_id": "mission.slot-settle",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Let a feasible retargeted batch reach its target; reconsider if blocked or if its displaced output is urgently needed.",
      "prefer": [
        {
          "when": {
            "family": "retarget",
            "slot_recent": true
          },
          "weight": 0.05
        }
      ]
    },
    {
      "rule_id": "mission.wait-rule",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Wait for relevant work already advancing, or when no useful legal action is available.",
      "prefer": [
        {
          "when": {
            "family": "wait",
            "others_available": true
          },
          "weight": 0.25
        }
      ]
    },
    {
      "rule_id": "mission.permanent-intermediates",
      "kind": "soft",
      "scopes": [
        "mission.mall"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Maintain reliable gear, stick, cable and circuit supply; dedicate cells when sustained demand justifies them.",
      "prefer": [
        {
          "when": {
            "family": "assemble",
            "product": [
              "iron-gear-wheel",
              "iron-stick",
              "copper-cable",
              "electronic-circuit"
            ]
          },
          "weight": 1.5
        }
      ]
    },
    {
      "rule_id": "mission.steel-for-poles",
      "kind": "soft",
      "scopes": [
        "mission.steel"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Establish steel before steel-dependent pole and assembler stock is exhausted."
    },
    {
      "rule_id": "mission.purposeful-coverage",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Extend robot coverage toward resources and sites required by current demand.",
      "prefer": [
        {
          "when": {
            "need": "coverage"
          },
          "weight": 0.4
        }
      ]
    },
    {
      "rule_id": "mission.conserve-scarce",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer actions that preserve scarce construction stock for upcoming useful builds.",
      "prefer": [
        {
          "when": {
            "scarce": true
          },
          "weight": 0.35
        }
      ]
    },
    {
      "rule_id": "mission.ops-starter",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "In the current ops adapter, establish a plate's direct starter before its foundation.",
      "prefer": [
        {
          "when": {
            "family": "starter",
            "plate_stage": "none"
          },
          "weight": 5.0
        },
        {
          "when": {
            "family": "starter",
            "plate_stage": [
              "starter",
              "foundation"
            ]
          },
          "weight": 0.05
        }
      ]
    },
    {
      "rule_id": "mission.ops-foundation",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer a mine and six-furnace foundation after its plate starter produces; reconcile the same transaction on retries.",
      "prefer": [
        {
          "when": {
            "family": "foundation",
            "plate_stage": "starter"
          },
          "weight": 1.0
        },
        {
          "when": {
            "family": "foundation",
            "plate_stage": [
              "none",
              "foundation"
            ]
          },
          "weight": 0.1
        }
      ]
    },
    {
      "rule_id": "mission.ops-extend",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Extend an open refinery in place by one six-furnace module, with its mine, while its plate is still short.",
      "prefer": [
        {
          "when": {
            "family": "extend",
            "plate_stage": "foundation"
          },
          "weight": 3.0
        },
        {
          "when": {
            "family": "extend",
            "plate_stage": [
              "none",
              "starter"
            ]
          },
          "weight": 0.05
        }
      ]
    },
    {
      "rule_id": "mission.ops-shortage",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Reconcile current material shortfalls and produce missing items before retrying the blocked transaction.",
      "prefer": [
        {
          "when": {
            "family": "produce"
          },
          "weight": 4.0
        },
        {
          "when": {
            "family": [
              "foundation",
              "extend"
            ],
            "last_code": "material_shortage"
          },
          "weight": 0.3
        }
      ]
    },
    {
      "rule_id": "mission.ops-wait",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "While relevant bots or coverage are advancing, wait or serve independent work.",
      "prefer": [
        {
          "when": {
            "family": "wait",
            "constructing": true
          },
          "weight": 3.0
        },
        {
          "when": {
            "family": "wait",
            "constructing": false
          },
          "weight": 0.2
        }
      ]
    },
    {
      "rule_id": "mission.ops-retry-after-wait",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Retry a construction or coverage wait after observation shows progress or its retry horizon expires.",
      "prefer": [
        {
          "when": {
            "waiting": true
          },
          "weight": 0.1
        }
      ]
    },
    {
      "rule_id": "mission.ops-mall-slots",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer gear, cable and circuit producers, then belt capacity, before foundations; preserve their construction budget.",
      "prefer": [
        {
          "when": {
            "family": "mall_slot",
            "product": [
              "iron-gear-wheel",
              "copper-cable",
              "electronic-circuit"
            ]
          },
          "weight": 30.0
        },
        {
          "when": {
            "family": "mall_slot"
          },
          "weight": 6.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-steel-fence",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Reserve the funded steel seed's poles before competing builds consume them.",
      "prefer": [
        {
          "when": {
            "family": "reserve_steel_seed"
          },
          "weight": 8.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-steel",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Start the funded steel seed when iron supply is verified and lifecycle admission permits it, including the pioneer-output cycle break.",
      "prefer": [
        {
          "when": {
            "family": "steel"
          },
          "weight": 5.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-retire-starter",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Retire a starter only after its replacement delivers plates; recover entities and contents with bots.",
      "prefer": [
        {
          "when": {
            "family": "retire_starter"
          },
          "weight": 2.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-no-blind-retry",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Retry a material-blocked transaction after its required stock or allocation changes; reuse its existing plan.",
      "prefer": [
        {
          "when": {
            "unchanged_failure": true
          },
          "weight": 0.05
        }
      ]
    },
    {
      "rule_id": "mission.ops-one-batch",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Let a feasible mall batch finish; interrupt when its inputs cannot arrive or its lender blocks a more urgent dependency.",
      "prefer": [
        {
          "when": {
            "family": [
              "produce",
              "mall_slot"
            ],
            "batch_active": true
          },
          "weight": 0.05
        },
        {
          "when": {
            "family": "wait",
            "constructing": true
          },
          "weight": 3.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-starters-before-foundations",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "Prefer finishing iron, copper and stone starters before foundations consume their reserved drills.",
      "prefer": [
        {
          "when": {
            "family": "starter",
            "product": "stone-brick",
            "plate_stage": "none"
          },
          "weight": 2.0
        }
      ]
    },
    {
      "rule_id": "mission.ops-history-no-repeat",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "After repeated same-cause failures, prefer a different action until relevant facts change."
    },
    {
      "rule_id": "mission.ops-history-follow-through",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "After useful output, prefer continuing related work when it still serves current demand."
    },
    {
      "rule_id": "mission.ops-history-unstick",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "After several decisions without useful progress, explore an untried feasible operation."
    },
    {
      "rule_id": "mission.ops-no-idle-loans",
      "kind": "soft",
      "scopes": [
        "mission.decide"
      ],
      "source": "docs/rl/Laya_Strategy_Guidelines.md",
      "quote": "A borrowed cell is a finite batch, not a standing producer; request it for a current shortfall and account for displaced output."
    }
  ]
}
