{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Detailed Laya acceptance evidence; current conditions are separate from monotonic reached status.",
  "type": "object",
  "required": ["version", "scope", "observation", "statuses", "results"],
  "properties": {
    "version": {"const": "laya-acceptance-v1"},
    "machine_counter_units": {"type": "object", "properties": {"kind": {"const": "scaled_machine_progress"}, "completed_craft_scale": {"const": 1000}, "note": {"type": "string"}}},
    "run_id": {"type": "string"}, "at": {"type": "string"},
    "scope": {"type": "object", "required": ["episode_id"], "properties": {"episode_id": {"type": "string"}, "surface": {"type": "string"}, "force": {"type": "string"}, "server_root": {"type": "string"}, "bootstrap_profile": {"type": "string"}}},
    "observation": {"type": "object", "required": ["observed_at", "source", "snapshot"], "properties": {"observed_at": {"type": "string"}, "source": {"type": "string"}, "snapshot": {"type": "object"}}},
    "statuses": {"type": "object", "additionalProperties": {"enum": ["passed", "failed", "unknown"]}},
    "results": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["checkpoint_id", "predicate_version", "status", "latched_status", "evidence", "missing"],
      "properties": {
        "checkpoint_id": {"type": "string"}, "predicate_version": {"type": "string"},
        "status": {"enum": ["passed", "failed", "unknown"]}, "latched_status": {"enum": ["passed", "failed", "unknown"]},
        "evidence": {"type": "object", "properties": {"checks": {"type": "object", "additionalProperties": {"type": ["boolean", "null"]}}}},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "tooling": {"type": "object"}, "mall_targets": {"type": "object"},
    "predicate_comparisons": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["checkpoint_id", "predicate_version", "status", "evidence", "missing"],
      "properties": {"checkpoint_id": {"type": "string"}, "predicate_version": {"type": "string"},
                     "status": {"enum": ["passed", "failed", "unknown"]}, "evidence": {"type": "object"},
                     "missing": {"type": "array", "items": {"type": "string"}}}}}}
  }
}
