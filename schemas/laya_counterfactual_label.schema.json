{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "laya_counterfactual_label.schema.json",
  "$comment": "Path: schemas/laya_counterfactual_label.schema.json | Purpose: Version outcome evidence for completion-first replay labels.",
  "type": "object",
  "required": ["version", "options", "cost_ticks", "outcomes", "base_repeat_outcomes", "noise_ticks", "temperature_ticks", "soft_target", "preference_weight", "preference_exclusion"],
  "properties": {
    "version": {"const": "laya-counterfactual-v4"},
    "options": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "sampling_version": {"enum": ["global-60-v1", "episode-relative-v1"]},
    "cost_ticks": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "number", "minimum": 0}},
    "outcomes": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/definitions/outcome"}},
    "base_repeat_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/outcome"}},
    "noise_ticks": {"type": "number", "minimum": 0},
    "temperature_ticks": {"type": "number", "exclusiveMinimum": 0},
    "soft_target": {"type": ["object", "null"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "preference_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "preference_exclusion": {"type": "string"}
  },
  "definitions": {
    "outcome": {
      "type": "object",
      "required": ["status", "failure_cause", "failure_kind", "reason", "elapsed_ticks", "safety_violations", "progress", "journal"],
      "properties": {
        "status": {"enum": ["completed", "timed_out", "failed", "escalated", "cleanup_failed"]},
        "failure_cause": {"enum": ["none", "policy", "observation", "tool", "validator", "documentation", "environment", "unknown"]},
        "failure_kind": {"type": "string", "minLength": 1},
        "reason": {"type": "string"},
        "elapsed_ticks": {"type": ["number", "null"], "minimum": 0},
        "safety_violations": {"type": "integer", "minimum": 0},
        "progress": {"type": "object"},
        "journal": {"type": "string", "minLength": 1},
        "sampling_version": {"enum": ["global-60-v1", "episode-relative-v1"]}
      }
    }
  }
}
