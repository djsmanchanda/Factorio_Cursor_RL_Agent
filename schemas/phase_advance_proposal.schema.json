{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhaseAdvanceProposal",
  "description": "Read-only proposal to advance capacity phase.",
  "type": "object",
  "required": ["status", "reason", "current_phase", "next_phase"],
  "properties": {
    "status": { "type": "string", "enum": ["ELIGIBLE", "INELIGIBLE"] },
    "reason": { "type": "string" },
    "current_phase": { "type": "integer", "minimum": 0 },
    "next_phase": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
