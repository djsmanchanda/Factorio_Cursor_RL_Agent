{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "laya_coach_record.schema.json",
  "title": "LayaCoachRecord",
  "description": "A bounded, human-authored observation or label captured from the Factorio guidance window.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "record_id", "captured_at", "decision_kind", "source", "guidance", "options"],
  "properties": {
    "version": { "const": "1.0.0" },
    "record_id": { "$ref": "#/definitions/id" },
    "captured_at": { "type": "string", "format": "date-time" },
    "reviewer_id": { "$ref": "#/definitions/id" },
    "decision_kind": {
      "enum": ["serve_goal", "choose_operation", "select_site", "select_scale", "select_route", "select_research", "select_upgrade", "recovery", "wait_or_act", "select_candidate"]
    },
    "source": { "$ref": "#/definitions/source" },
    "guidance": { "$ref": "#/definitions/guidance" },
    "options": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/id" },
          { "$ref": "#/definitions/option" }
        ]
      }
    },
    "chosen_option_id": { "$ref": "#/definitions/id" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "state": { "type": "object" },
    "evidence_hash": { "$ref": "#/definitions/hash" },
    "observation": { "type": "object" },
    "area": { "$ref": "#/definitions/area" }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "surface", "force", "tick"],
      "properties": {
        "runtime": { "enum": ["disposable_training", "real_nauvis", "legacy_retired"] },
        "surface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "force": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tick": { "type": "integer", "minimum": 0 },
        "elapsed_ticks": { "type": "integer", "minimum": 0 },
        "run_id": { "$ref": "#/definitions/id" },
        "episode_id": { "$ref": "#/definitions/id" },
        "trajectory_id": { "$ref": "#/definitions/id" },
        "scenario_id": { "$ref": "#/definitions/id" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "scenario_hash": { "$ref": "#/definitions/hash" },
        "bounds": { "type": ["object", "null"] }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "instruction", "outcome"],
      "properties": {
        "focus": { "enum": ["throughput", "reliability", "efficiency", "exploration", "general"] },
        "goal_id": { "$ref": "#/definitions/id" },
        "goal": { "type": "string", "maxLength": 512 },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "outcome": { "enum": ["unknown", "success", "failure", "blocked"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "feedback_kind": { "enum": ["guidance", "correction", "label", "outcome"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "area": {
      "type": "object",
      "description": "A box the reviewer dragged with the read-only coach area tool.",
      "additionalProperties": false,
      "required": ["left_top", "right_bottom", "selection_mode", "entity_count", "entities", "resources"],
      "properties": {
        "left_top": { "$ref": "#/definitions/point" },
        "right_bottom": { "$ref": "#/definitions/point" },
        "surface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tick": { "type": "integer", "minimum": 0 },
        "selection_mode": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
        "entity_count": { "type": "integer", "minimum": 0 },
        "entities": {
          "type": "array",
          "maxItems": 160,
          "items": {
            "type": "object",
            "required": ["name", "position"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "type": { "type": "string", "maxLength": 64 },
              "position": { "$ref": "#/definitions/point" }
            }
          }
        },
        "resources": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "resource_entity_count": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "summary"],
      "properties": {
        "option_id": { "$ref": "#/definitions/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operation_family": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tool_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "features": { "type": "object" },
        "signature": { "$ref": "#/definitions/hash" },
        "plan_hash": { "$ref": "#/definitions/hash" }
      }
    }
  }
}
