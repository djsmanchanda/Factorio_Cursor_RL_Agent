{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapacityAllocation",
  "description": "Deterministic conservative phase budget allocation for a selected expansion target.",
  "type": "object",
  "required": [
    "target_block",
    "target_recipe",
    "phase_capacity",
    "allocated_now",
    "reserved_for_later",
    "rationale"
  ],
  "properties": {
    "target_block": {
      "type": "string",
      "minLength": 1
    },
    "target_recipe": {
      "type": "string",
      "minLength": 1
    },
    "phase_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "allocated_now": {
      "type": "integer",
      "minimum": 0
    },
    "reserved_for_later": {
      "type": "integer",
      "minimum": 0
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
