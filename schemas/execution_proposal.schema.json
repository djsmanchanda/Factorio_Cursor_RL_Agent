{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionProposal",
  "description": "Read-only execution readiness proposal based on reconciled progress.",
  "type": "object",
  "required": [
    "allowed_actions",
    "blocked_actions",
    "requires_human_approval",
    "next_recommended_step"
  ],
  "properties": {
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "project_more_ghosts",
          "request_phase_advance",
          "request_module_upgrade",
          "hold_position"
        ]
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "requires_human_approval": { "type": "boolean" },
    "next_recommended_step": {
      "type": "string",
      "enum": ["request_phase_advance", "project_more_ghosts", "hold_position"]
    }
  },
  "additionalProperties": false
}
