{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Correlated layout submission receipts 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "request_id", "request_digest", "tick", "ok"],
  "properties": {
    "receipt_version": {"enum": ["layout-submission-receipt-v1", "layout-submission-receipt-v2"]},
    "request_id": {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$"},
    "request_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "stream_id": {"type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[0-9a-f]{16}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "tick": {"type": "integer", "minimum": 0},
    "ok": {"type": "boolean"},
    "error": {"type": "string", "minLength": 1},
    "attempted_ghosts": {"$ref": "#/definitions/count"},
    "placed_ghosts": {"$ref": "#/definitions/count"},
    "already_present_ghosts": {"$ref": "#/definitions/count"},
    "failed_ghosts": {"$ref": "#/definitions/count"},
    "attempted_entities": {"$ref": "#/definitions/count"},
    "placed_entities": {"$ref": "#/definitions/count"},
    "already_present_entities": {"$ref": "#/definitions/count"},
    "failed_entities": {"$ref": "#/definitions/count"},
    "attempted_placements": {"$ref": "#/definitions/count"},
    "succeeded_placements": {"$ref": "#/definitions/count"},
    "already_present_placements": {"$ref": "#/definitions/count"},
    "failed_placements": {"$ref": "#/definitions/count"},
    "recipe_failures": {"$ref": "#/definitions/count"},
    "removed_entities": {"$ref": "#/definitions/count"},
    "wires_connected": {"$ref": "#/definitions/count"},
    "placement_failures": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "action_type", "position", "reason"],
      "properties": {"phase": {"type": "string"}, "action_type": {"type": "string"},
        "entity": {"type": "string"}, "reason": {"type": "string"},
        "position": {"type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}}
    }}
  },
  "definitions": {"count": {"type": "integer", "minimum": 0}},
  "allOf": [{"if": {"properties": {"receipt_version": {"const": "layout-submission-receipt-v2"}}},
    "then": {"required": ["stream_id", "sequence"]},
    "else": {"not": {"anyOf": [{"required": ["stream_id"]}, {"required": ["sequence"]}]}}},
    {"if": {"properties": {"ok": {"const": true}}},
    "then": {"required": ["attempted_placements", "succeeded_placements", "already_present_placements",
                          "failed_placements", "placement_failures"],
             "not": {"required": ["error"]}},
    "else": {"required": ["error"]}}]
}
