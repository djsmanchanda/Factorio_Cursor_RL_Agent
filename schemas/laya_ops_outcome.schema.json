{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Path: schemas/laya_ops_outcome.schema.json | Purpose: Version the observed-action corpus separately from ranking cases.",
  "title": "Laya observed operation outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "split", "state", "options", "choice", "distribution", "observed_outcome", "terminal_outcome", "provenance"],
  "properties": {
    "version": {"const": "laya-ops-outcome-v1"},
    "split": {"enum": ["train", "calibration", "held_out", "test"]},
    "state": {"type": "object", "minProperties": 1},
    "options": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["option_id"], "properties": {"option_id": {"type": "string", "minLength": 1}}}},
    "choice": {"type": "object", "required": ["option_id"], "properties": {"option_id": {"type": "string", "minLength": 1}}},
    "distribution": {"type": ["object", "array", "null"]},
    "observed_outcome": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}},
    "terminal_outcome": {"type": "object", "properties": {
      "accepted_ever": {"type": ["array", "null"], "items": {"type": "string"}},
      "accepted_final": {"type": ["array", "null"], "items": {"type": "string"}}
    }},
    "provenance": {"type": "object", "required": ["batch", "job", "seed", "arm", "run_id", "index", "revision", "source_sha256", "freeze_sha256", "record_sha256"], "properties": {
      "batch": {"type": "string"}, "job": {"type": "string"}, "arm": {"type": "string"},
      "seed": {"type": "integer"}, "run_id": {"type": "string", "minLength": 1},
      "index": {"type": "integer", "minimum": 0},
      "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }}
  }
}
