{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupervisorIntent",
  "description": "High-level intent emitted by the supervisory layer. Intents describe WHAT kind of change is needed, not HOW it is executed.",
  "type": "object",
  "required": ["intent", "scope", "urgency"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "Canonical intent identifier",
      "enum": [
        "reduce_bot_dependency",
        "prepare_transport_migration",
        "increase_transport_capacity",
        "stabilize_power_margin",
        "prepare_upgrade_phase",
        "delay_expansion",
        "increase_buffering",
        "rebalance_supply_chain",
        "investigate_anomaly"
      ]
    },
    "scope": {
      "type": "string",
      "description": "Where the intent applies",
      "enum": ["local", "block", "city", "planet", "interplanetary"]
    },
    "urgency": {
      "type": "string",
      "description": "How quickly this intent should be addressed",
      "enum": ["low", "medium", "high", "critical"]
    },
    "blocked_by": {
      "type": "array",
      "description": "Prerequisites that must be satisfied before this intent can be planned",
      "items": { "type": "string" },
      "default": []
    },
    "confidence": {
      "type": "number",
      "description": "Supervisor confidence in this intent (0.0 – 1.0)",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0
    },
    "evidence": {
      "type": "array",
      "description": "Metrics or policy signals that led to this intent",
      "items": {
        "type": "object",
        "required": ["source", "value"],
        "properties": {
          "source": { "type": "string" },
          "value": {}
        }
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "description": "Human-readable explanation for debugging and auditing"
    }
  },
  "additionalProperties": false
}
