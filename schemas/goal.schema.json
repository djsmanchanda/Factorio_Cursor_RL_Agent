{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal",
  "type": "object",
  "required": ["target", "delta"],
  "properties": {
    "target": { "type": "string" },
    "delta": {
      "type": "object",
      "required": ["rate", "unit"],
      "properties": {
        "rate": { "type": "number" },
        "unit": { "type": "string", "enum": ["per_second"] }
      }
    },
    "area": {
      "type": "object",
      "properties": {
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
