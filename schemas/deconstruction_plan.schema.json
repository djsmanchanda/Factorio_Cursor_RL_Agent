{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeconstructionPlan",
  "description": "Authorized deconstruction actions for existing entities.",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "position"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["deconstruct_entity"]
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": false
          },
          "name": { "type": "string" },
          "block": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
