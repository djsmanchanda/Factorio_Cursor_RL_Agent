{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanningGateDecision",
  "description": "Readiness decision before planning begins.",
  "type": "object",
  "required": ["status", "reason", "required_actions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "blocked", "defer"]
    },
    "reason": { "type": "string" },
    "required_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
