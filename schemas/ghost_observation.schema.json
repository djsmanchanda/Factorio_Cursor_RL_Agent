{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GhostObservation",
  "description": "Read-only observation of ghost entities in the sandbox surface.",
  "type": "object",
  "required": ["tick", "surface", "ghosts"],
  "properties": {
    "tick": { "type": "integer", "minimum": 0 },
    "surface": { "type": "string" },
    "ghosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prototype", "tags"],
        "properties": {
          "prototype": { "type": "string" },
          "tags": {
            "type": "object",
            "required": ["block", "phase", "capacity_slice"],
            "properties": {
              "block": { "type": "string" },
              "phase": { "type": "string" },
              "capacity_slice": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "aggregates": {
      "type": "object",
      "properties": {
        "counts_by_block": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "counts_by_phase": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "counts_by_capacity_slice": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
