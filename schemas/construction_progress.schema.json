{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConstructionProgress",
  "description": "Read-only progress update derived from construction results.",
  "type": "object",
  "required": [
    "status",
    "reason",
    "started",
    "completed",
    "previous_current_capacity",
    "updated_current_capacity"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OK", "PARTIAL", "BLOCKED"]
    },
    "reason": { "type": "string" },
    "started": { "type": "integer", "minimum": 0 },
    "completed": { "type": "integer", "minimum": 0 },
    "previous_current_capacity": { "type": "integer", "minimum": 0 },
    "updated_current_capacity": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
