{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExpansionTarget",
  "description": "Deterministic read-only expansion target selection from pressure telemetry.",
  "type": "object",
  "required": [
    "target_block",
    "target_recipe",
    "confidence",
    "rationale"
  ],
  "properties": {
    "target_block": {
      "type": "string",
      "minLength": 1
    },
    "target_recipe": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
