{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionAuthorization",
  "description": "Explicit authorization for execution actions derived from an ExecutionProposal.",
  "type": "object",
  "required": [
    "approved_actions",
    "denied_actions",
    "authorization_timestamp",
    "authorization_source"
  ],
  "properties": {
    "approved_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "denied_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scope_limits": {
      "type": "object",
      "properties": {
        "max_count": { "type": "integer", "minimum": 0 },
        "surface": { "type": "string", "minLength": 1 },
        "force": { "type": "string", "minLength": 1 },
        "block_filter": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "dependencies": { "surface": ["force"], "force": ["surface"] }
    },
    "authorization_timestamp": { "type": "string" },
    "authorization_source": {
      "type": "string",
      "enum": ["human", "policy", "test"]
    }
  },
  "additionalProperties": false
}
