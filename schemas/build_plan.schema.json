{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "BuildPlan 1.4",
 "type": "object",
 "required": [
  "phases"
 ],
 "properties": {
  "phases": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "actions"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "actions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "action_type",
        "position"
       ],
       "properties": {
        "action_type": {
         "type": "string",
         "enum": [
          "place_ghost",
          "place_tile_ghost",
          "place_entity",
          "remove_entity"
         ]
        },
        "entity": {
         "type": "string"
        },
        "tile": {
         "type": "string",
         "description": "Tile item placed as a construction ghost; currently used for landfill water crossings."
        },
        "position": {
         "type": "object",
         "required": [
          "x",
          "y"
         ],
         "properties": {
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          }
         }
        },
        "direction": {
         "type": "string",
         "enum": [
          "north",
          "east",
          "south",
          "west"
         ]
        },
        "input_priority": {
         "type": "string",
         "enum": [
          "left",
          "none",
          "right"
         ],
         "description": "Splitter input priority copied from an approved blueprint."
        },
        "output_priority": {
         "type": "string",
         "enum": [
          "left",
          "none",
          "right"
         ],
         "description": "Splitter output priority copied from an approved blueprint."
        },
        "underground_type": {
         "type": "string",
         "enum": [
          "input",
          "output"
         ]
        },
        "recipe": {
         "type": "string"
        },
        "logistic_request": {
         "type": "object",
         "description": "Logistic request set on a requester/buffer chest, so bots deliver an ingredient instead of a belt carrying it.",
         "required": [
          "name",
          "count"
         ],
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string"
          },
          "count": {
           "type": "integer",
           "minimum": 1
          }
         }
        },
        "logistic_requests": {
         "type": "array",
         "description": "Multiple item requests configured as slots in one logistic section.",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "name",
           "count"
          ],
          "additionalProperties": false,
          "properties": {
           "name": {
            "type": "string"
           },
           "count": {
            "type": "integer",
            "minimum": 1
           }
          }
         }
        },
        "logistic_group": {
         "type": "string",
         "minLength": 1,
         "description": "Named Factorio logistic group shared by copies of this requester configuration."
        },
        "logistic_sections": {
         "type": "array",
         "description": "One named logistic section per set of machines this chest feeds. Each section is upserted by group name, so a chest serving two machines carries two independently maintained groups and the game sums them. Requests are the group's per-craft amounts; multiplier scales them for this chest.",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "group",
           "requests"
          ],
          "additionalProperties": false,
          "properties": {
           "group": {
            "type": "string",
            "minLength": 1
           },
           "multiplier": {
            "type": "integer",
            "minimum": 1
           },
           "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": "object",
             "required": [
              "name",
              "count"
             ],
             "additionalProperties": false,
             "properties": {
              "name": {
               "type": "string"
              },
              "count": {
               "type": "integer",
               "minimum": 1
              }
             }
            }
           }
          }
         }
        },
        "clear_logistic_groups": {
         "type": "array",
         "description": "Clear named requester sections when a mall machine is retired.",
         "minItems": 1,
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "inventory_limit": {
         "type": "object",
         "description": "Exact item-count reserve converted into a chest slot bar using the live item stack size, or an explicit request to fill the chest.",
         "required": [
          "name",
          "count",
          "minimum_stacks_by_group"
         ],
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string"
          },
          "count": {
           "type": "integer",
           "minimum": 1
          },
          "fill_chest": {
           "type": "boolean"
          },
          "minimum_stacks_by_group": {
           "type": "object",
           "required": [
            "production",
            "logistics",
            "intermediate-products"
           ],
           "additionalProperties": false,
           "properties": {
            "production": {
             "type": "integer",
             "minimum": 1
            },
            "logistics": {
             "type": "integer",
             "minimum": 1
            },
            "intermediate-products": {
             "type": "integer",
             "minimum": 1
            }
           }
          }
         }
        },
        "infinity_filter": {
         "type": "string"
        },
        "fill_percentage": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "clear_logistic_condition": {
         "type": "boolean"
        },
        "logistic_condition": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "signal",
          "comparator",
          "constant"
         ],
         "properties": {
          "signal": {
           "type": "string",
           "minLength": 1
          },
          "comparator": {
           "enum": [
            "<",
            ">",
            "=",
            "\u2265",
            "\u2264",
            "\u2260",
            ">=",
            "<=",
            "!="
           ]
          },
          "constant": {
           "type": "integer"
          }
         }
        }
       },
       "allOf": [
        {
         "if": {
          "required": [
           "action_type"
          ],
          "properties": {
           "action_type": {
            "enum": [
             "place_ghost",
             "place_entity",
             "remove_entity"
            ]
           }
          }
         },
         "then": {
          "required": [
           "entity"
          ]
         }
        },
        {
         "if": {
          "required": [
           "action_type"
          ],
          "properties": {
           "action_type": {
            "enum": [
             "place_tile_ghost"
            ]
           }
          }
         },
         "then": {
          "required": [
           "tile"
          ],
          "not": {
           "required": [
            "entity"
           ]
          }
         }
        },
        {
         "if": {
          "required": [
           "entity",
           "action_type"
          ],
          "properties": {
           "entity": {
            "pattern": "underground-belt$"
           },
           "action_type": {
            "enum": [
             "place_ghost",
             "place_entity"
            ]
           }
          }
         },
         "then": {
          "required": [
           "underground_type"
          ]
         }
        }
       ]
      }
     }
    }
   }
  }
 }
}
