{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optimizer submission transaction journal (offline bookkeeping; grants no authority)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "transaction_id", "episode_id", "project_id", "binding", "artifact_sha256", "attempts"],
  "properties": {
    "version": {"const": "optimizer-submission-transaction-v1"},
    "transaction_id": {"$ref": "#/definitions/hex32"},
    "episode_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^optimizer:.+"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["scope", "project_id", "transaction_id", "plan_hash"], "properties": {
      "scope": {"type": "object", "additionalProperties": false, "required": ["instance_id", "manifest_digest", "surface", "force"], "properties": {
        "instance_id": {"type": "string", "minLength": 1}, "manifest_digest": {"$ref": "#/definitions/digest"},
        "surface": {"type": "string", "minLength": 1}, "force": {"type": "string", "minLength": 1}}},
      "project_id": {"type": "string", "minLength": 1}, "transaction_id": {"$ref": "#/definitions/hex32"},
      "plan_hash": {"$ref": "#/definitions/digest"}}},
    "artifact_sha256": {"$ref": "#/definitions/digest"},
    "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/attempt"}}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "count": {"type": "integer", "minimum": 0},
    "counts": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/count"}},
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "request_id", "status", "ledger_revision", "funding", "request_sha256", "request"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "request_id": {"$ref": "#/definitions/hex32"},
        "status": {"enum": ["prepared", "submitting", "not_sent", "received", "recovered", "ambiguous"]},
        "ledger_revision": {"$ref": "#/definitions/count"},
        "ledger_sha256": {"$ref": "#/definitions/digest"},
        "funding": {"type": "object", "additionalProperties": false,
          "required": ["state", "required", "reserved", "project_revision"], "properties": {
            "state": {"const": "ready"}, "required": {"$ref": "#/definitions/counts"},
            "reserved": {"$ref": "#/definitions/counts"}, "project_revision": {"type": "integer", "minimum": 1}}},
        "request_sha256": {"$ref": "#/definitions/digest"},
        "request": {"type": "object", "additionalProperties": false, "required": ["authorization", "build_plan"], "properties": {
          "authorization": {"type": "object"}, "build_plan": {"type": "object"}}},
        "receipt": {"type": "object"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["submitting", "received", "recovered", "ambiguous"]}}},
         "then": {"required": ["ledger_sha256"]}},
        {"if": {"properties": {"status": {"enum": ["received", "recovered", "ambiguous"]}}},
         "then": {"required": ["receipt"]}, "else": {"not": {"required": ["receipt"]}}},
        {"if": {"properties": {"status": {"enum": ["not_sent", "ambiguous"]}}},
         "then": {"required": ["reason"]}, "else": {"not": {"required": ["reason"]}}}
      ]
    }
  }
}
