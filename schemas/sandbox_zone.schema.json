{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SandboxZone",
  "description": "Deterministic sandbox zoning coordinates for a block.",
  "type": "object",
  "required": [
    "block_id",
    "origin_x",
    "origin_y",
    "stride_x",
    "stride_y"
  ],
  "properties": {
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_x": {
      "type": "integer"
    },
    "origin_y": {
      "type": "integer"
    },
    "stride_x": {
      "type": "integer",
      "minimum": 1
    },
    "stride_y": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
