{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Path: schemas/oil_transaction.schema.json | Purpose: Immutable episode-owned opening oil intent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "identity",
    "intent",
    "intent_sha256",
    "complete"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "surface",
        "force"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "force": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_output",
        "plans",
        "links",
        "packets",
        "coal",
        "coal_belt_type",
        "coal_actions"
      ],
      "properties": {
        "target_output": {
          "enum": [
            "plastic-bar",
            "sulfur"
          ]
        },
        "plans": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/plan"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/plan"
              }
            ]
          }
        },
        "packets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/plan"
              }
            ]
          }
        },
        "coal": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "coal_belt_type": {
          "enum": [
            "transport-belt",
            "fast-transport-belt",
            "express-transport-belt"
          ]
        },
        "coal_actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "required": [
        "phases"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actions"
            ],
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
