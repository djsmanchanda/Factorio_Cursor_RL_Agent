{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "material_reservation_ledger.schema.json",
  "title": "Deterministic Material Reservation Ledger 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "episode_id", "surface", "force", "revision", "projects"],
  "properties": {
    "version": { "const": 1 },
    "episode_id": { "$ref": "#/definitions/nonEmptyString" },
    "surface": { "$ref": "#/definitions/nonEmptyString" },
    "force": { "$ref": "#/definitions/nonEmptyString" },
    "revision": { "type": "integer", "minimum": 0 },
    "bootstrap_supply": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targets", "inserted"],
        "properties": {
          "targets": {
            "allOf": [
              { "$ref": "#/definitions/counts" },
              { "minProperties": 1 }
            ]
          },
          "inserted": { "$ref": "#/definitions/counts" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/definitions/project" }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "nullableStringMap": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/definitions/nonEmptyString" }, { "type": "null" }]
      }
    },
    "nullableNumberMap": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id", "target_item", "state", "required", "reserved",
        "source_producers", "expected_rates", "eta_seconds", "priority",
        "sequence", "hold_until_producing", "revision"
      ],
      "properties": {
        "project_id": { "$ref": "#/definitions/nonEmptyString" },
        "target_item": {
          "anyOf": [{ "$ref": "#/definitions/nonEmptyString" }, { "type": "null" }]
        },
        "state": {
          "enum": ["planned", "supply_wait", "ready", "constructing", "completed", "failed"]
        },
        "required": {
          "allOf": [
            { "$ref": "#/definitions/counts" },
            { "minProperties": 1 }
          ]
        },
        "reserved": { "$ref": "#/definitions/counts" },
        "source_producers": { "$ref": "#/definitions/nullableStringMap" },
        "expected_rates": { "$ref": "#/definitions/nullableNumberMap" },
        "eta_seconds": { "$ref": "#/definitions/nullableNumberMap" },
        "priority": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 1 },
        "hold_until_producing": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
