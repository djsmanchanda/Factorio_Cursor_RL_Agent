{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laya saved-world factual observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tick", "surface", "force", "mods", "networks", "ports", "poles", "machines", "resources", "player_stock", "production", "consumption", "researched", "pending_ghosts"],
  "properties": {
    "version": {"const": "saved-world-v1"},
    "tick": {"type": "integer", "minimum": 0},
    "surface": {"const": "nauvis"},
    "force": {"const": "player"},
    "mods": {"type": "object", "additionalProperties": {"type": "string"}},
    "networks": {"type": "object", "additionalProperties": {"$ref": "#/definitions/network"}},
    "ports": {"type": "array", "items": {"type": "object", "required": ["position", "network", "energy", "construction_radius", "logistic_radius"], "properties": {"position": {"$ref": "#/definitions/position"}, "network": {"type": "string"}, "energy": {"$ref": "#/definitions/count"}, "construction_radius": {"$ref": "#/definitions/count"}, "logistic_radius": {"$ref": "#/definitions/count"}}}},
    "poles": {"type": "array", "items": {"type": "object", "required": ["name", "position", "wire", "supply", "grid", "generated"], "properties": {"name": {"type": "string"}, "position": {"$ref": "#/definitions/position"}, "wire": {"$ref": "#/definitions/count"}, "supply": {"$ref": "#/definitions/count"}, "grid": {"type": "string"}, "generated": {"type": "boolean"}, "unit_number": {"type": "integer", "minimum": 1}, "quality": {"type": "string", "minLength": 1}}}},
    "machines": {"type": "array", "items": {"type": "object", "required": ["name", "position", "energy", "status"], "properties": {"name": {"type": "string"}, "position": {"$ref": "#/definitions/position"}, "energy": {"$ref": "#/definitions/count"}, "status": {"type": "string"}, "recipe": {"type": "string"}}}},
    "resources": {"type": "array", "items": {"type": "object", "required": ["item", "position", "remaining"], "properties": {"item": {"enum": ["iron-ore", "copper-ore", "coal", "stone"]}, "position": {"$ref": "#/definitions/position"}, "remaining": {"$ref": "#/definitions/count"}}}},
    "player_stock": {"type": "object", "additionalProperties": {"$ref": "#/definitions/stock"}},
    "production": {"$ref": "#/definitions/stock"},
    "consumption": {"$ref": "#/definitions/stock"},
    "researched": {"type": "object", "additionalProperties": {"const": true}},
    "enabled_recipes": {"type": "object", "additionalProperties": {"const": true}},
    "pending_ghosts": {"type": "integer", "minimum": 0},
    "quad_centers": {"type": "array", "items": {"$ref": "#/definitions/position"}},
    "infrastructure_counts": {"$ref": "#/definitions/stock"},
    "recipe_observations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/recipe_observation"}
    },
    "recipe_catalog": {
      "type": "object", "additionalProperties": false,
      "description": "Survey-local metadata around the force.recipes observation map. This is not the /export_recipe_catalog document: it carries no recipes, machines, raw_resources or stack_sizes. The shared version token is a consumer contract, not provenance.",
      "required": ["version", "force", "tick", "surface", "recipe_count", "source", "complete", "document", "metadata_only", "category_metadata_unsupported"],
      "properties": {
        "version": {"const": "1.2.0"},
        "force": {"const": "player"},
        "tick": {"type": "integer", "minimum": 0},
        "surface": {"const": "nauvis"},
        "recipe_count": {"type": "integer", "minimum": 0},
        "source": {"const": "force.recipes"},
        "complete": {"type": "boolean"},
        "document": {"const": "saved-world-recipe-survey"},
        "metadata_only": {"const": true},
        "category_metadata_unsupported": {"type": "integer", "minimum": 0}
      }
    },
    "fluid_recipes": {
      "type": "object",
      "description": "Enabled recipes with a fluid ingredient or product, keyed by recipe name. Facts only: kept out of 'recipes', which is the solid build menu. Product amounts are expected amounts (probability applied).",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["ingredients", "products", "energy_ticks", "machine_speeds"],
        "properties": {
          "ingredients": {"$ref": "#/definitions/recipe_parts"},
          "products": {"$ref": "#/definitions/recipe_parts"},
          "energy_ticks": {"type": "number", "exclusiveMinimum": 0},
          "category": {"type": "string"},
          "machine_speeds": {"oneOf": [{"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}}, {"type": "array", "maxItems": 0}]},
          "productivity_bonus": {"type": "number", "minimum": 0}
        }
      }
    },
    "oil_field": {
      "type": "object", "additionalProperties": false,
      "description": "Read-only survey of the nearest crude-oil patch (wells within 32 tiles of the nearest well) and water tile to the base anchor, within search_radius of generated terrain.",
      "required": ["anchor", "anchor_source", "search_radius", "found", "wells", "water"],
      "properties": {
        "anchor": {"$ref": "#/definitions/position"},
        "anchor_source": {"enum": ["roboport", "spawn"]},
        "search_radius": {"type": "number", "exclusiveMinimum": 0},
        "found": {"type": "boolean"},
        "wells": {"type": "integer", "minimum": 0},
        "total_amount": {"$ref": "#/definitions/count"},
        "yield_percent": {"$ref": "#/definitions/count"},
        "max_crude_per_s": {"$ref": "#/definitions/count"},
        "center": {"$ref": "#/definitions/position"},
        "distance": {"$ref": "#/definitions/count"},
        "nearest_well_distance": {"$ref": "#/definitions/count"},
        "water": {
          "type": "object", "additionalProperties": false, "required": ["found"],
          "properties": {"found": {"type": "boolean"}, "unknown": {"const": true},
                         "position": {"$ref": "#/definitions/position"}, "distance": {"$ref": "#/definitions/count"}}
        }
      }
    },
    "recipes": {"type": "object", "additionalProperties": {"type": "object", "required": ["ingredients", "product_amount", "energy_ticks"], "properties": {"ingredients": {"type": "array", "items": {"type": "object", "required": ["name", "amount"], "properties": {"name": {"type": "string"}, "amount": {"type": "number", "exclusiveMinimum": 0}}}}, "product_amount": {"type": "number", "exclusiveMinimum": 0}, "energy_ticks": {"type": "integer", "minimum": 1}}}}
  },
  "definitions": {
    "recipe_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "ingredients", "products", "categories", "machine_speeds", "energy_ticks"],
      "properties": {
        "enabled": {"type": ["boolean", "null"]},
        "ingredients": {"$ref": "#/definitions/recipe_parts"},
        "products": {"$ref": "#/definitions/recipe_parts"},
        "category": {"type": "string"},
        "categories": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "object", "maxProperties": 0}]},
        "machine_speeds": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
        "energy_ticks": {"type": "number", "exclusiveMinimum": 0},
        "productivity_bonus": {"type": "number", "minimum": 0}
      }
    },
    "recipe_parts": {
      "oneOf": [
        {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "type"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "type": {"enum": ["item", "fluid"]},
            "amount": {"type": "number", "minimum": 0},
            "amount_min": {"type": "number", "minimum": 0},
            "amount_max": {"type": "number", "minimum": 0},
            "ignored_by_productivity": {"type": "number", "minimum": 0},
            "probability": {"type": "number", "minimum": 0, "maximum": 1},
            "independent_probability": {"type": "number", "minimum": 0, "maximum": 1},
            "shared_probability": {
              "type": "object", "additionalProperties": false, "required": ["min", "max"],
              "properties": {
                "min": {"type": "number", "minimum": 0, "maximum": 1},
                "max": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "extra_count_fraction": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }},
        {"type": "object", "maxProperties": 0}
      ]
    },
    "count": {"type": "number", "minimum": 0},
    "stock": {"type": "object", "additionalProperties": {"$ref": "#/definitions/count"}},
    "position": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "network": {"type": "object", "additionalProperties": false, "required": ["items", "reserved", "construction_robots", "available_construction_robots", "logistic_robots"], "properties": {"items": {"$ref": "#/definitions/stock"}, "reserved": {"$ref": "#/definitions/stock"}, "construction_robots": {"type": "integer", "minimum": 0}, "available_construction_robots": {"type": "integer", "minimum": 0}, "logistic_robots": {"type": "integer", "minimum": 0}}}
  }
}
