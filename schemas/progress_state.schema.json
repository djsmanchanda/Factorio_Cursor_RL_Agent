{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProgressState",
  "description": "Read-only progress state derived from snapshot, metrics, and prior intents.",
  "type": "object",
  "required": [
    "ultimate_capacity",
    "current_capacity",
    "committed_capacity",
    "active_phase_capacity",
    "completed_phases",
    "rationale"
  ],
  "properties": {
    "ultimate_capacity": { "type": "integer", "minimum": 0 },
    "current_capacity": { "type": "integer", "minimum": 0 },
    "committed_capacity": { "type": "integer", "minimum": 0 },
    "active_phase_capacity": { "type": "integer", "minimum": 0 },
    "completed_phases": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "rationale": { "type": "string" }
  },
  "additionalProperties": false
}
