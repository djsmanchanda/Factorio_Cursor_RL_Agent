{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeconstructionAuthorization",
  "description": "Authorization for deconstruction execution.",
  "type": "object",
  "required": ["approved_actions", "denied_actions", "authorization_timestamp", "authorization_source"],
  "properties": {
    "approved_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "denied_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "reason"],
        "properties": {
          "action": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scope_limits": {
      "type": "object",
      "properties": {
        "max_count": { "type": "integer", "minimum": 0 },
        "block_filter": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "authorization_timestamp": { "type": "string" },
    "authorization_source": { "type": "string", "enum": ["human", "policy", "test"] }
  },
  "additionalProperties": false
}
