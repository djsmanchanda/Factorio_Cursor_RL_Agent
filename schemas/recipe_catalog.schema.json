{
  "$schema":"http://json-schema.org/draft-07/schema#","$id":"recipe_catalog.schema.json","title":"RecipeCatalog","type":"object","additionalProperties":false,
  "required":["version","force","tick","raw_resources","recipes"],
  "properties":{"version":{"const":"1.0.0"},"force":{"type":"string","minLength":1},"tick":{"type":"integer","minimum":0},"raw_resources":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"recipes":{"type":"array","items":{"$ref":"#/definitions/recipe"}}},
  "definitions":{
