    "recipe":{"type":"object","additionalProperties":false,"required":["name","enabled","category","energy_ticks","ingredients","products","supported"],"properties":{"name":{"type":"string","minLength":1},"enabled":{"type":"boolean"},"category":{"type":"string","minLength":1},"energy_ticks":{"type":"integer","minimum":1},"ingredients":{"type":"array","items":{"$ref":"#/definitions/part"}},"products":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/part"}},"supported":{"type":"boolean"},"unsupported_reason":{"type":"string","minLength":1}}}
  }
}
