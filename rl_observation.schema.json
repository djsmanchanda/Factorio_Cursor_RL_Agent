{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RLObservation",
  "description": "Read-only observation for non-authoritative RL action advising.",
  "type": "object",
  "required": [
    "progress_state",
    "capacity_phasing",
    "latest_metrics_summary",
    "phase_completion_status"
  ],
  "properties": {
    "progress_state": {
      "type": "object",
      "required": [
        "ultimate_capacity",
        "current_capacity",
        "committed_capacity",
        "active_phase_capacity",
        "completed_phases",
        "rationale"
      ],
      "properties": {
        "ultimate_capacity": { "type": "integer", "minimum": 0 },
        "current_capacity": { "type": "integer", "minimum": 0 },
        "committed_capacity": { "type": "integer", "minimum": 0 },
        "active_phase_capacity": { "type": "integer", "minimum": 0 },
        "completed_phases": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capacity_phasing": {
      "type": "object",
      "required": [
        "desired_active_capacity",
        "previous_active_capacity",
        "reason",
        "next_allowed_actions"
      ],
      "properties": {
        "desired_active_capacity": { "type": "integer", "minimum": 0 },
        "previous_active_capacity": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "next_allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ghost_expand", "ghost_upgrade"]
          }
        }
      },
      "additionalProperties": false
    },
    "latest_metrics_summary": {
      "type": "object",
      "required": ["current_capacity"],
      "properties": {
        "current_capacity": { "type": "integer", "minimum": 0 },
        "bot_headroom": { "type": "number" },
        "priority_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["block", "score"],
            "properties": {
              "block": { "type": "string", "minLength": 1 },
              "score": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "phase_completion_status": {
      "type": "string",
      "enum": ["OK", "PARTIAL", "BLOCKED", "COMPLETE", "INCOMPLETE"]
    }
  },
  "additionalProperties": false
}
