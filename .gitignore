# Path: Factorio_Cursor_RL_Agent/.gitignore
# Purpose: Keep generated artifacts (bytecode, game output, local scratch) out of version control.

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/

# Game-produced JSON artifacts (snapshots, observations, reports)
script-output/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store
runs/

# Local RL training evidence and checkpoints
data/training/*.db*
data/training/live/
data/training/policy.json
data/training-archive/
data/training-capacity/
# Local pytest scratch directories
.pytest_cache/
.pytest-*/
.tmp-pytest*/
.tmp_pytest/
.training-test-tmp/
.training-guidance-test-temp/
.review-observer-tests/

# Local isolated worker endpoints and passwords
training-workers.json
training-workers-wsl.json
data/training/logs/
data/rl-gpu-venv/
