{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RLActionProposal",
  "description": "Non-authoritative RL advisory action proposal. This payload never grants execution authority.",
  "type": "object",
  "required": [
    "proposed_action_type",
    "confidence",
    "rationale",
    "requires_authorization"
  ],
  "properties": {
    "proposed_action_type": {
      "type": "string",
      "enum": [
        "hold_position",
        "project_more_ghosts",
        "request_phase_advance",
        "request_module_upgrade"
      ]
    },
    "target_block": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "requires_authorization": {
      "const": true
    }
  },
  "additionalProperties": false
}
